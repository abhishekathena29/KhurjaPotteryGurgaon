# Non-secret initialization values consumed by `npm run seed:config`.
# Money values use paise.
COMMERCE_CURRENCY=INR
DELIVERY_FEE_PAISE=5000
PREPAID_ENABLED=false
RESERVATION_TTL_MINUTES=15
MANUAL_PAYMENT_VERIFICATION_TTL_MINUTES=1440
MANUAL_PAYMENT_QR_URL=
MANUAL_PAYMENT_PAYEE_NAME=
MANUAL_PAYMENT_INSTRUCTIONS=Scan the QR, pay the exact order total, and upload the successful-payment screenshot.
SKU_PREFIX=PC
SKU_PADDING=6
ORDER_PREFIX=ORD
ORDER_PADDING=7
BEST_SELLER_WINDOW_DAYS=90
BEST_SELLER_LIMIT=12

# When this package is deployed as Firebase Functions, provider credentials use
# Firebase secrets. The standalone backend reads the same names from host secrets.

# Standalone backend runtime. These values are server-only and must never use
# a VITE_ prefix or be committed with real credentials.
PORT=3001
HOST=127.0.0.1
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Local development can point to the downloaded key instead of embedding it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternative for local use only; prefer the base64 value in hosted secrets.
FIREBASE_SERVICE_ACCOUNT_JSON=
BACKEND_ADMIN_EMAILS=admin@example.com
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_ENFORCE_APP_CHECK=true
BACKEND_MAX_IMAGE_BYTES=10485760
BACKEND_CRON_SECRET=replace-with-a-long-random-secret
BACKEND_STORAGE_DRIVER=local
# Required only for BACKEND_STORAGE_DRIVER=local.
BACKEND_UPLOAD_DIR=/absolute/path/to/backend/uploads
BACKEND_PRIVATE_UPLOAD_DIR=/absolute/path/to/backend/private-uploads
BACKEND_PUBLIC_URL=http://127.0.0.1:3001

# Durable, disk-free production storage for Render. Product/QR images are
# public Cloudinary assets; payment proofs use authenticated Cloudinary assets
# and remain accessible only through the backend's authorized proof endpoint.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=potters-central

# Optional provider webhook adapter and notification worker. Manual QR checkout does
# not require provider credentials.
PAYMENT_PROVIDER_ENDPOINT=
PAYMENT_PROVIDER_TOKEN=
PAYMENT_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_ENDPOINT=
NOTIFICATION_WEBHOOK_TOKEN=
