rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function validImageSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && validImageSize();
    }

    match /product-requests/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId
        && isImage() && validImageSize();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
