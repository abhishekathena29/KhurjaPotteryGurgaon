# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Local development only: use `true` once to generate a token, then register
# and store the resulting debug token here. Never set this in production.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Cloudinary Configuration — product images, payment QR, and payment-proof
# screenshots all upload directly from the browser via an *unsigned* upload
# preset. Create a free account, then add one under Settings -> Upload.
# These values are public client config, not secrets.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
