# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Local development only: use `true` once to generate a token, then register
# and store the resulting debug token here. Never set this in production.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Standalone backend. Use /api when frontend and backend share one domain, or
# the full HTTPS backend origin when they are deployed separately.
VITE_BACKEND_API_URL=/api
# Read by Vite only for local proxying; it is not exposed to browser code.
BACKEND_DEV_PROXY_TARGET=http://127.0.0.1:3001

# Product image upload driver: "backend" (recommended) uploads through the
# authenticated commerce backend and uses its configured storage provider.
# "cloudinary" is retained for legacy direct-browser unsigned uploads only.
VITE_IMAGE_UPLOAD_DRIVER=backend

# Cloudinary Configuration (required when VITE_IMAGE_UPLOAD_DRIVER=cloudinary).
# Create a free account, then add an *unsigned* upload preset under
# Settings -> Upload. These values are public client config, not secrets.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
